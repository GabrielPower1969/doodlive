 ],
 "lines": [
  {
   "id": "es_01",
   "t": 1.45,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.96,
   "ref": "Esther 1:1-2",
   "zh": "很久很久以前，在波斯的书珊城里，住着一位很有权力的国王——亚哈随鲁王。",
   "en": "Long, long ago, in the city of Susa, there lived a very powerful king. His name was King Xerxes.",
   "dir": "storyteller opening; warm, unhurried, a little mysterious; small pause before the name",
   "dur": 8.91,
   "pre": 0.25,
   "post": 0.5,
   "anchor": {
    "line": "",
    "edge": "origin",
    "dt": 1.45
   }
  },
  {
   "id": "es_02",
   "t": 11.11,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.36,
   "ref": "Esther 2:7, 2:17",
   "zh": "国王选了一位又美丽、又善良的女孩做王后。她的名字，叫以斯帖。",
   "en": "The king chose a beautiful, kind young woman to be his queen. Her name was Esther.",
   "dir": "tender, smiling; slow down on her name",
   "dur": 7.31,
   "pre": 0.25,
   "post": 0.3,
   "anchor": {
    "line": "es_01",
    "edge": "end",
    "dt": 0.75
   }
  },
  {
   "id": "es_03a",
   "t": 20.02,
   "who": "herald",
   "voice": "herald",
   "maxSec": 6.02,
   "ref": "Esther 3:1",
   "zh": "哈曼大人驾到——！",
   "en": "Make way for the great Lord Haman!",
   "dir": "off-stage court herald, loud and long, ceremonial, a little pompous",
   "dur": 5.97,
   "pre": 0.3,
   "post": 0.1,
   "anchor": {
    "line": "es_02",
    "edge": "end",
    "dt": 1.6
   }
  },
  {
   "id": "es_03b",
   "t": 26.69,
   "who": "crowd",
   "voice": "crowd",
   "maxSec": 3.85,
   "ref": "Esther 3:2",
   "zh": "拜见哈曼大人！",
   "en": "Hail, Lord Haman!",
   "dir": "many people at once, off-stage, bowing; a little reluctant",
   "dur": 3.8,
   "pre": 0.6,
   "post": 0.2,
   "anchor": {
    "line": "es_03a",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "es_03",
   "t": 31.19,
   "who": "haman",
   "voice": "haman",
   "maxSec": 9.97,
   "ref": "Esther 3:1-2",
   "zh": "哼哼！看见没有？人人见了我，都得弯腰！我可是全国第一大官——哈哈哈哈！",
   "en": "Ho ho! Did you see that? Everyone bows when I walk by! I'm the greatest man in the whole kingdom! Ha ha ha ha!",
   "dir": "hugely pleased with himself, nose in the air, savouring every word; a real belly laugh at the end that goes on a bit too long",
   "dur": 9.92,
   "pre": 0.5,
   "post": 0.2,
   "anchor": {
    "line": "es_03b",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "es_04",
   "t": 41.61,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.88,
   "ref": "Esther 3:2-4",
   "zh": "可是有一个人，偏偏不拜他。末底改说：我只拜上帝。",
   "en": "But one man would not bow. Mordecai said, \"I bow only to God.\"",
   "dir": "calm, a little amused; a small pause before Mordecai's words",
   "dur": 6.83,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "es_03",
    "edge": "end",
    "dt": 0.5
   }
  },
  {
   "id": "es_04b",
   "t": 48.84,
   "who": "haman",
   "voice": "haman",
   "maxSec": 6.01,
   "ref": "Esther 3:5",
   "zh": "什么？！他竟敢不拜我？！气死我了！哼！哼！哼！",
   "en": "What?! He won't bow to ME?! Grrr! Hmph! Hmph! Hmph!",
   "dir": "explodes: shrill, spluttering fury, a tantrum; three stamping 'hmph's, each louder; comic, not scary",
   "dur": 5.96,
   "pre": 0.2,
   "post": 0.3,
   "anchor": {
    "line": "es_04",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "es_05",
   "t": 56.7,
   "who": "haman",
   "voice": "haman",
   "maxSec": 11.09,
   "ref": "Esther 3:8-9",
   "zh": "王啊……有一群人，不守您的规矩。不如……让我把他们都除掉吧？",
   "en": "O king... there are some people who don't keep your laws. Why not... let me get rid of them?",
   "dir": "sly half-whisper, slow, oily, sugary-sweet to the king; two sneaky pauses",
   "dur": 11.04,
   "pre": 1.6,
   "post": 0.4,
   "anchor": {
    "line": "es_04b",
    "edge": "end",
    "dt": 1.9
   }
  },
  {
   "id": "es_06",
   "t": 68.39,
   "who": "king",
   "voice": "king",
   "maxSec": 6.29,
   "ref": "Esther 3:10-11",
   "zh": "嗯……好吧。这枚戒指给你，你看着办。",
   "en": "Hmm... very well. Take my ring. Do as you see fit.",
   "dir": "deep, careless, a little bored; a thinking 'hmm' first",
   "dur": 6.24,
   "pre": 0.25,
   "post": 0.2,
   "anchor": {
    "line": "es_05",
    "edge": "end",
    "dt": 0.65
   }
  },
  {
   "id": "es_06b",
   "t": 75.83,
   "who": "haman",
   "voice": "haman",
   "maxSec": 3.0,
   "ref": "Esther 3:10-11",
   "zh": "嘿嘿嘿……这下，谁也拦不住我啦！",
   "en": "Heh heh heh... Now nobody can stop me!",
   "dir": "turns to the audience, rubbing his hands; a wicked little giggle, then gleeful",
   "dur": 2.95,
   "pre": 1.0,
   "post": 0.5,
   "anchor": {
    "line": "es_06",
    "edge": "end",
    "dt": 1.2
   }
  },
  {
   "id": "es_07",
   "t": 79.88,
   "who": "mordecai",
   "voice": "mordecai",
   "maxSec": 7.07,
   "ref": "Esther 4:8, 4:14",
   "zh": "以斯帖，你要去求王救我们！说不定，你当上王后，就是为了今天！",
   "en": "Esther, you must ask the king to save us! Maybe this is why you became queen, for a time just like this!",
   "dir": "older man, urgent but loving, from a distance (slight room echo); slower on the last sentence",
   "dur": 7.02,
   "pre": 0.6,
   "post": 0.5,
   "anchor": {
    "line": "es_06b",
    "edge": "end",
    "dt": 1.1
   }
  },
  {
   "id": "es_08",
   "t": 87.65,
   "who": "esther",
   "voice": "esther",
   "maxSec": 7.29,
   "ref": "Esther 4:11",
   "zh": "可是……没有王的召见就进去，是会死的……",
   "en": "But... anyone who goes to the king without being called could die...",
   "dir": "scared, quiet, hesitant; breath before 'but'",
   "dur": 7.24,
   "pre": 0.25,
   "post": 0.7,
   "anchor": {
    "line": "es_07",
    "edge": "end",
    "dt": 0.75
   }
  },
  {
   "id": "es_09",
   "t": 99.69,
   "who": "esther",
   "voice": "esther",
   "maxSec": 6.3,
   "ref": "Esther 4:16",
   "zh": "好！请大家为我祷告。我要去见王——就算有危险，我也要去！",
   "en": "All right. Please pray for me. I will go to the king, even if it's dangerous!",
   "dir": "a deep breath, then steady and brave; rising resolve, strongest on the last words",
   "dur": 6.25,
   "pre": 0.9,
   "post": 0.4,
   "anchor": {
    "line": "es_08",
    "edge": "end",
    "dt": 4.8
   }
  },
  {
   "id": "es_10",
   "t": 107.74,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.72,
   "ref": "Esther 5:1",
   "zh": "以斯帖一步一步，走上王宫的台阶……王会怎么做呢？",
   "en": "Step by step, Esther climbed the palace stairs... What would the king do?",
   "dir": "hushed, suspenseful, slow; let the question hang",
   "dur": 8.67,
   "pre": 1.4,
   "post": 1.0,
   "anchor": {
    "line": "es_09",
    "edge": "end",
    "dt": 1.8
   }
  },
  {
   "id": "es_11",
   "t": 120.61,
   "who": "king",
   "voice": "king",
   "maxSec": 6.96,
   "ref": "Esther 5:2-3",
   "zh": "以斯帖王后！你来啦。你想要什么？就算是半个国家，我也给你！",
   "en": "Queen Esther! You've come. What is it you want? Even half my kingdom, it's yours!",
   "dir": "surprised, then warm and generous; a smile in the voice",
   "dur": 6.91,
   "pre": 2.4,
   "post": 0.3,
   "anchor": {
    "line": "es_10",
    "edge": "end",
    "dt": 4.2
   }
  },
  {
   "id": "es_12",
   "t": 128.12,
   "who": "esther",
   "voice": "esther",
   "maxSec": 3.94,
   "ref": "Esther 5:4",
   "zh": "请王带着哈曼，来吃我准备的宴席，好吗？",
   "en": "My king, will you come to my banquet? And bring Haman too.",
   "dir": "polite, sweet, a little clever; light",
   "dur": 3.89,
   "pre": 0.3,
   "post": 0.4,
   "anchor": {
    "line": "es_11",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "es_12b",
   "t": 133.01,
   "who": "haman",
   "voice": "haman",
   "maxSec": 7.84,
   "ref": "Esther 5:9-12",
   "zh": "王后的宴席，只请了王——和我！哈哈！我真是太了不起啦！",
   "en": "The queen's banquet! Only the king... and ME! Ha! Aren't I wonderful!",
   "dir": "giddy, bouncing with glee, almost singing; a pause before 'and me', then a delighted laugh",
   "dur": 7.79,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "es_12",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "es_12c",
   "t": 142.1,
   "who": "king",
   "voice": "king",
   "maxSec": 4.97,
   "ref": "Esther 6:6",
   "zh": "哈曼，我想尊荣一个人。你说，该怎么做呢？",
   "en": "Haman, there is a man I want to honour. What should I do for him?",
   "dir": "thoughtful, kind, slow; a real question",
   "dur": 4.92,
   "pre": 1.0,
   "post": 0.3,
   "anchor": {
    "line": "es_12b",
    "edge": "end",
    "dt": 1.3
   }
  },
  {
   "id": "es_12d",
   "t": 147.62,
   "who": "haman",
   "voice": "haman",
   "maxSec": 3.22,
   "ref": "Esther 6:6",
   "zh": "嘿嘿……除了我，还有谁呢？",
   "en": "Heh heh... who could that be, but me?",
   "dir": "a stage whisper to the audience behind his hand; smug, delighted",
   "dur": 3.17,
   "pre": 0.3,
   "post": 0.4,
   "anchor": {
    "line": "es_12c",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "es_12e",
   "t": 151.49,
   "who": "haman",
   "voice": "haman",
   "maxSec": 9.37,
   "ref": "Esther 6:7-9",
   "zh": "要给他穿上王袍，骑上王的马！还要有人在前面大声喊：看哪，这就是王要尊荣的人！",
   "en": "Dress him in the royal robe! Sit him on the king's own horse! And have someone shout: \"This is the man the king honours!\"",
   "dir": "grand, dreamy, carried away, bigger and bigger; the last phrase shouted proudly like a herald",
   "dur": 9.32,
   "pre": 0.3,
   "post": 0.3,
   "anchor": {
    "line": "es_12d",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "es_12f",
   "t": 161.31,
   "who": "king",
   "voice": "king",
   "maxSec": 4.32,
   "ref": "Esther 6:10",
   "zh": "好主意！你就照这样，去尊荣末底改吧！",
   "en": "Good idea! Now go and do all of that for Mordecai!",
   "dir": "pleased, warm, brisk; a smile; the name clear and simple",
   "dur": 4.27,
   "pre": 0.2,
   "post": 0.1,
   "anchor": {
    "line": "es_12e",
    "edge": "end",
    "dt": 0.5
   }
  },
  {
   "id": "es_12g",
   "t": 166.58,
   "who": "haman",
   "voice": "haman",
   "maxSec": 3.53,
   "ref": "Esther 6:10-11",
   "zh": "末……末……末底改？！",
   "en": "Mor... Mor... MORDECAI?!",
   "dir": "can't believe it: choking, stammering, then a strangled squeak on the name",
   "dur": 3.48,
   "pre": 0.9,
   "post": 0.6,
   "anchor": {
    "line": "es_12f",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "es_12h",
   "t": 171.06,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.96,
   "ref": "Esther 6:11",
   "zh": "于是，哈曼只好牵着王的马，带着末底改满城走，还得一边走，一边喊——",
   "en": "So Haman had to lead Mordecai through the city on the king's horse, shouting all the way...",
   "dir": "trying not to laugh; storyteller relishing the twist",
   "dur": 6.91,
   "pre": 0.4,
   "post": 0.1,
   "anchor": {
    "line": "es_12g",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "es_12i",
   "t": 178.27,
   "who": "haman",
   "voice": "haman",
   "maxSec": 4.72,
   "ref": "Esther 6:11",
   "zh": "这……就是王要尊荣的人……哼！",
   "en": "This... is the man the king honours... hmph!",
   "dir": "through gritted teeth, sulky, flat and grudging, a dying-off 'hmph'",
   "dur": 4.67,
   "pre": 0.2,
   "post": 0.2,
   "anchor": {
    "line": "es_12h",
    "edge": "end",
    "dt": 0.3
   }
  },
  {
   "id": "es_13",
   "t": 186.74,
   "who": "esther",
   "voice": "esther",
   "maxSec": 4.48,
   "ref": "Esther 7:3-4",
   "zh": "王啊……有人要害我，还要害我的族人！",
   "en": "My king... someone wants to destroy me, and all my people!",
   "dir": "trembling but brave; voice catches on 'my people'",
   "dur": 4.43,
   "pre": 0.4,
   "post": 0.3,
   "anchor": {
    "line": "es_12i",
    "edge": "end",
    "dt": 3.8
   }
  },
  {
   "id": "es_14",
   "t": 191.97,
   "who": "king",
   "voice": "king",
   "maxSec": 2.95,
   "ref": "Esther 7:5",
   "zh": "什么？！是谁？谁敢这样做？",
   "en": "What?! Who is he? Who would dare?",
   "dir": "shocked and angry, loud but not shouting; short sharp phrases",
   "dur": 2.9,
   "pre": 0.5,
   "post": 0.2,
   "anchor": {
    "line": "es_13",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "es_15",
   "t": 195.27,
   "who": "esther",
   "voice": "esther",
   "maxSec": 3.11,
   "ref": "Esther 7:6",
   "zh": "就是他——这个坏人哈曼！",
   "en": "It's him! This wicked man, Haman!",
   "dir": "clear and firm, a beat of courage before 'Haman'",
   "dur": 3.06,
   "pre": 0.2,
   "post": 0.2,
   "anchor": {
    "line": "es_14",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "es_16",
   "t": 199.33,
   "who": "haman",
   "voice": "haman",
   "maxSec": 7.19,
   "ref": "Esther 7:7-8",
   "zh": "不、不、不！王后，救救我吧！王啊，饶命啊！",
   "en": "No, no, no! My queen, save me! Oh king, have mercy!",
   "dir": "blubbering, squeaky panic, fast and breathless, close to tears; comic",
   "dur": 7.14,
   "pre": 0.8,
   "post": 0.2,
   "anchor": {
    "line": "es_15",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "es_16b",
   "t": 206.87,
   "who": "king",
   "voice": "king",
   "maxSec": 2.08,
   "ref": "Esther 7:8-9",
   "zh": "来人！把他带走！",
   "en": "Guards! Take him away!",
   "dir": "a royal command, loud, deep and final; not a scream",
   "dur": 2.03,
   "pre": 0.2,
   "post": 0.1,
   "anchor": {
    "line": "es_16",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "es_16c",
   "t": 211.2,
   "who": "haman",
   "voice": "haman",
   "maxSec": 8.42,
   "ref": "Esther 7:8",
   "zh": "不——要——啊——！放开我！我是大官！我是……哇啊啊啊——！",
   "en": "Nooo! Let me go! I'm a very important man! I'm... waaaah!",
   "dir": "wailing and kicking as he is dragged off; long howling 'no', then outraged, then a big wail that fades away into the distance",
   "dur": 8.37,
   "pre": 0.2,
   "post": 0.2,
   "anchor": {
    "line": "es_16b",
    "edge": "end",
    "dt": 2.3
   }
  },
  {
   "id": "es_17",
   "t": 221.77,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.67,
   "ref": "Esther 7:10, 8:16-17",
   "zh": "王把哈曼带走了。上帝的百姓得救啦！大家又唱又跳，好开心！",
   "en": "The king had Haman taken away. God's people were saved! Everyone sang and danced for joy!",
   "dir": "relief, then bright joy; speed up a little on the happy part",
   "dur": 7.62,
   "pre": 0.8,
   "post": 0.6,
   "anchor": {
    "line": "es_16c",
    "edge": "end",
    "dt": 2.2
   }
  },
  {
   "id": "es_18",
   "t": 230.59,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.2,
   "ref": "Esther 4:14-16",
   "zh": "以斯帖害怕的时候，还是选择了勇敢，选择了信靠上帝。你也可以哦！",
   "en": "Esther was scared, but she chose to be brave and to trust God. You can too!",
   "dir": "warm moral, speaking right to the child; smile on 'You can too'",
   "dur": 8.15,
   "pre": 0.6,
   "post": 2.0,
   "anchor": {
    "line": "es_17",
    "edge": "end",
    "dt": 1.2
   }
  }
 ],
