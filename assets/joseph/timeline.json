    "target": "pit",
    "dist": 0.56,
    "height": 0.3,
    "yawDeg": 12
   },
   "desc": "Out in the fields the brother pulls off Joseph's coat and lowers him into a dry well. A camel caravan comes by; silver coins change hands; Joseph is led away. Back home, Jacob weeps.",
   "t0": 50.87,
   "t1": 84.18,
   "anchor": {
    "line": "js_07",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
