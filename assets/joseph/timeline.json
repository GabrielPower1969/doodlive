    "height": 0.2,
    "yawDeg": -20
   },
   "desc": "Night in the palace. Pharaoh nods off on his feet; a picture cloud shows seven fat cows and seven thin cows, then seven fat ears of grain and seven thin ones. He wakes with a jump.",
   "t0": 109.01,
   "t1": 137.34,
   "anchor": {
    "line": "js_14",
    "edge": "end",
    "dt": 0.6
   }
