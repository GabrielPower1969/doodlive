  {
   "id": "js_27",
   "t": 219.27,
   "who": "brother",
   "voice": "brother",
   "maxSec": 6.25,
   "ref": "Genesis 45:3; 50:17",
   "zh": "约……约瑟？对不起！我们对你做了那么坏的事……",
   "en": "J-Joseph? I'm sorry! We did such a terrible thing to you...",
   "dir": "shaking, ashamed, close to tears; the apology is real",
   "dur": 6.2,
   "pre": 0.3,
   "post": 0.4,
   "anchor": {
