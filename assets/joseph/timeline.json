    "target": "joseph",
    "dist": 0.55,
    "height": 0.22,
    "yawDeg": 10
   },
   "desc": "Egypt. Joseph works hard carrying jars; then, though he did nothing wrong, he sits in a prison cell. A warm light stays on him.",
   "t0": 84.18,
   "t1": 109.01,
   "anchor": {
    "line": "js_11",
    "edge": "end",
    "dt": 0.8
   }
  },
