  },
  {
   "id": "js_30",
   "t": 244.52,
   "who": "jacob",
   "voice": "jacob",
   "maxSec": 6.13,
   "ref": "Genesis 46:30",
   "zh": "约瑟！我的孩子……我又看见你了！",
