   "voice": "joseph",
   "maxSec": 4.34,
   "ref": "Genesis 45:3-4",
   "zh": "哥哥，是我呀——我就是约瑟！",
   "en": "Brothers, it's me... I am Joseph!",
   "dir": "the dam breaks: tears and joy at once; the name bursts out",
   "dur": 4.29,
   "pre": 0.8,
   "post": 0.3,
   "anchor": {
