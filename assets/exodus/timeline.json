  },
  {
   "id": "ex_34",
   "t": 273.68,
   "who": "people",
   "voice": "people",
   "maxSec": 2.56,
   "ref": "Exodus 15:1",
   "zh": "唱歌吧！向上帝唱歌！",
   "en": "Sing to the Lord! Sing!",
   "dir": "the crowd echoing her chant, happy, in rhythm, slightly ragged",
   "dur": 2.51,
   "pre": 0.483,
