 ],
 "lines": [
  {
   "id": "ex_01",
   "t": 1.65,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 15.15,
   "ref": "Exodus 1:8-14",
   "zh": "很久很久以前，以色列人住在埃及。埃及的王叫法老，他让以色列人做奴隶，天天做砖、搬砖，累得腰都直不起来。",
   "en": "Long, long ago, God's people, the Israelites, lived in Egypt. The king of Egypt, Pharaoh, made them slaves. Every day they made bricks and carried bricks, until their backs ached.",
   "dir": "storyteller opening, slow and a little heavy; real weight on 累得腰都直不起来 / 'backs ached'",
   "dur": 15.1,
   "pre": 0.25,
   "post": 0.3,
   "anchor": {
    "line": "",
    "edge": "origin",
    "dt": 1.65
   }
  },
  {
   "id": "ex_02",
   "t": 17.35,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 5.14,
   "ref": "Exodus 5:6-8, 5:18",
   "zh": "快点！快点！今天的砖，一块都不许少！哼！",
   "en": "Faster! Faster! Not one brick less today! Hmph!",
   "dir": "pompous, bossy, loving the sound of his own voice; a snooty Hmph at the end",
   "dur": 5.09,
   "pre": 0.3,
   "post": 0.4,
   "anchor": {
    "line": "ex_01",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_03",
   "t": 23.64,
   "who": "miriam",
   "voice": "miriam",
   "maxSec": 4.87,
   "ref": "Exodus 2:23-24",
   "zh": "上帝啊……你听见我们在哭吗？求你救救我们吧！",
   "en": "Oh God... can you hear us crying? Please, please save us!",
   "dir": "tired, quiet, from the heart; a breath before 求你 / 'please'; not melodramatic",
   "dur": 4.82,
   "pre": 0.8,
   "post": 0.6,
   "anchor": {
    "line": "ex_02",
    "edge": "end",
    "dt": 1.2
   }
  },
  {
   "id": "ex_04",
   "t": 30.06,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 11.92,
   "ref": "Exodus 2:10, 3:1, 7:7",
   "zh": "这时候，在很远很远的旷野里，有个放羊的老爷爷，名叫摩西。他小时候在埃及王宫里长大，现在胡子都白啦。",
   "en": "Far away in the wilderness lived an old shepherd named Moses. He grew up in Pharaoh's palace when he was young, but now his beard was white.",
   "dir": "gentle, a small smile on 胡子都白啦 / 'his beard was white'",
   "dur": 11.87,
   "pre": 1.0,
   "post": 0.2,
   "anchor": {
    "line": "ex_03",
    "edge": "end",
    "dt": 1.6
   }
  },
  {
   "id": "ex_05",
   "t": 43.93,
   "who": "moses",
   "voice": "moses",
   "maxSec": 7.99,
   "ref": "Exodus 3:2-3",
   "zh": "咦？那丛荆棘着火了……怎么烧不坏呢？我过去看看。",
   "en": "Hm? That bush is on fire... but it isn't burning up! I'll go and have a look.",
   "dir": "an old man's wonder; slow thinking 咦 / 'hm' first; quieter on 我过去看看",
   "dur": 7.94,
   "pre": 0.6,
   "post": 0.5,
   "anchor": {
    "line": "ex_04",
    "edge": "end",
    "dt": 2.0
   }
  },
  {
   "id": "ex_06",
   "t": 52.97,
   "who": "god",
   "voice": "god",
   "maxSec": 2.57,
   "ref": "Exodus 3:4",
   "zh": "摩西，摩西！",
   "en": "Moses! Moses!",
   "dir": "calm, deep, kind; not loud; like a father calling a child by name; a little space between the two",
   "dur": 2.52,
   "pre": 0.6,
   "post": 0.4,
   "anchor": {
    "line": "ex_05",
    "edge": "end",
    "dt": 1.1
   }
  },
  {
   "id": "ex_07",
   "t": 56.19,
   "who": "moses",
   "voice": "moses",
   "maxSec": 2.4,
   "ref": "Exodus 3:4",
   "zh": "我……我在这里！",
   "en": "I... I'm here!",
   "dir": "startled, then humble and soft",
   "dur": 2.35,
   "pre": 0.3,
   "post": 0.6,
   "anchor": {
    "line": "ex_06",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "ex_08",
   "t": 59.54,
   "who": "god",
   "voice": "god",
   "maxSec": 10.66,
   "ref": "Exodus 3:7-10",
   "zh": "我看见我的百姓在埃及受苦，也听见了他们的哭声。现在你去见法老，把他们带出埃及吧。",
   "en": "I have seen my people suffering in Egypt, and I have heard them crying. Now go to Pharaoh, and bring my people out of Egypt.",
   "dir": "steady, warm, compassionate on 听见了他们的哭声 / 'heard them crying'; firm and kind on the sending",
   "dur": 10.61,
   "pre": 0.4,
   "post": 0.6,
   "anchor": {
    "line": "ex_07",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "ex_09",
   "t": 71.15,
   "who": "moses",
   "voice": "moses",
   "maxSec": 9.59,
   "ref": "Exodus 3:11, 4:10",
   "zh": "我？我算什么呀……而且我嘴笨，一说话就……就结结巴巴的。",
   "en": "Me? Who am I?... And I'm no good at talking. When I speak, I... I get all mixed up.",
   "dir": "nervous and shy, a little stammer on 就……就 / 'I... I'; a self-conscious laugh-sigh",
   "dur": 9.54,
   "pre": 0.4,
   "post": 0.5,
   "anchor": {
    "line": "ex_08",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "ex_10",
   "t": 81.49,
   "who": "god",
   "voice": "god",
   "maxSec": 4.22,
   "ref": "Exodus 4:2-3",
   "zh": "你手里拿的是什么？把它丢在地上。",
   "en": "What is that in your hand? Throw it on the ground.",
   "dir": "gentle, almost amused; patient",
   "dur": 4.17,
   "pre": 0.3,
   "post": 0.3,
   "anchor": {
    "line": "ex_09",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "ex_11",
   "t": 86.46,
   "who": "moses",
   "voice": "moses",
   "maxSec": 3.6,
   "ref": "Exodus 4:3",
   "zh": "哇！蛇！蛇！",
   "en": "Whoa! A snake! A snake!",
   "dir": "comic fright, quick and high, a squeak in it; the second 蛇 / 'snake' even higher",
   "dur": 3.55,
   "pre": 0.5,
   "post": 0.3,
   "anchor": {
    "line": "ex_10",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "ex_12",
   "t": 90.61,
   "who": "god",
   "voice": "god",
   "maxSec": 7.0,
   "ref": "Exodus 4:4, 4:12",
   "zh": "别怕，抓住它的尾巴。我会和你同在，教你该说什么话。",
   "en": "Don't be afraid. Take it by the tail. I will be with you, and I will teach you what to say.",
   "dir": "kind, reassuring, a smile in the voice; slower on 我会和你同在 / 'I will be with you'",
   "dur": 6.95,
   "pre": 0.3,
   "post": 0.3,
   "anchor": {
    "line": "ex_11",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_13",
   "t": 99.66,
   "who": "moses",
   "voice": "moses",
   "maxSec": 3.19,
   "ref": "Exodus 4:18-20",
   "zh": "好……我去！",
   "en": "All right... I'll go!",
   "dir": "a deep breath, then decided and brave; a little smile",
   "dur": 3.14,
   "pre": 1.8,
   "post": 0.6,
   "anchor": {
    "line": "ex_12",
    "edge": "end",
    "dt": 2.1
   }
  },
  {
   "id": "ex_14",
   "t": 107.4,
   "who": "moses",
   "voice": "moses",
   "maxSec": 5.24,
   "ref": "Exodus 5:1",
   "zh": "法老！上帝说：让我的百姓走！",
   "en": "Pharaoh! This is what God says: Let my people go!",
   "dir": "brave and clear, a strong voice now (the shy man is gone); a beat before 让我的百姓走 / 'Let my people go'",
   "dur": 5.19,
   "pre": 0.6,
   "post": 0.4,
   "anchor": {
    "line": "ex_13",
    "edge": "end",
    "dt": 4.6
   }
  },
  {
   "id": "ex_15",
   "t": 113.19,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 9.75,
   "ref": "Exodus 5:2",
   "zh": "哈哈哈！上帝？哪个上帝呀？我不认识！不放，就是不放！",
   "en": "Ha ha ha! God? Which god? Never heard of him! No! I won't let them go!",
   "dir": "a big fake belly laugh first; mocking; then stubborn and childish on 就是不放 / 'I won't'",
   "dur": 9.7,
   "pre": 0.2,
   "post": 0.5,
   "anchor": {
    "line": "ex_14",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_16",
   "t": 123.79,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.68,
   "ref": "Exodus 7-10",
   "zh": "于是，上帝降下了一样又一样的灾：河水变红了，到处都是青蛙，还有苍蝇、冰雹……",
   "en": "So God sent trouble after trouble: the river turned red, frogs hopped everywhere, then came flies, and hail...",
   "dir": "brisk and lively, a list with rhythm; a little giggle on 青蛙 / 'frogs'",
   "dur": 8.63,
   "pre": 0.4,
   "post": 0.4,
   "anchor": {
    "line": "ex_15",
    "edge": "end",
    "dt": 0.9
   }
  },
  {
   "id": "ex_17",
   "t": 133.82,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 6.98,
   "ref": "Exodus 8:8",
   "zh": "呱？……啊！青蛙！快拿走，快拿走！好好好，我放你们走！",
   "en": "Ribbit?... Aaah! A frog! Get it off, get it off! All right, all right, you can go!",
   "dir": "comic: a puzzled 'ribbit?' then a squeal; flustered, fast, high; gives in in a panic",
   "dur": 6.93,
   "pre": 1.0,
   "post": 0.5,
   "anchor": {
    "line": "ex_16",
    "edge": "end",
    "dt": 1.4
   }
  },
  {
   "id": "ex_18",
   "t": 141.85,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 4.55,
   "ref": "Exodus 8:15",
   "zh": "可是青蛙一走，法老就又变卦了。",
   "en": "But as soon as the frogs were gone, Pharaoh changed his mind.",
   "dir": "a knowing, teasing tone, like telling on a naughty child",
   "dur": 4.5,
   "pre": 0.6,
   "post": 0.2,
   "anchor": {
    "line": "ex_17",
    "edge": "end",
    "dt": 1.1
   }
  },
  {
   "id": "ex_19",
   "t": 146.85,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 3.76,
   "ref": "Exodus 8:15",
   "zh": "嘿嘿……不放了！",
   "en": "Heh heh... changed my mind!",
   "dir": "sly, smug, sing-song; a cheeky nyah-nyah feel",
   "dur": 3.71,
   "pre": 0.3,
   "post": 0.8,
   "anchor": {
    "line": "ex_18",
    "edge": "end",
    "dt": 0.5
   }
  },
  {
   "id": "ex_20",
   "t": 152.36,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 12.0,
   "ref": "Exodus 12:7, 12:13, 12:22-23",
   "zh": "最后，上帝要降下最重的一灾。他叫以色列人在门上做记号，那一夜都待在家里，平平安安的。",
   "en": "At last God said one more trouble would come, the worst of all. He told his people to put a mark on their doors and stay inside that night, and they would be safe.",
   "dir": "hushed and serious but safe and calm; warm on 平平安安的 / 'they would be safe'",
   "dur": 11.95,
   "pre": 1.0,
   "post": 0.3,
   "anchor": {
    "line": "ex_19",
    "edge": "end",
    "dt": 1.8
   }
  },
  {
   "id": "ex_21",
   "t": 164.91,
   "who": "miriam",
   "voice": "miriam",
   "maxSec": 5.09,
   "ref": "Exodus 12:11",
   "zh": "大家快吃饭，穿好鞋，拿好东西——今天晚上，我们就要出发啦！",
   "en": "Everyone, eat up! Shoes on, bags packed! Tonight we're leaving!",
   "dir": "excited whisper, quick, bustling; a thrill on 出发啦 / 'leaving'",
   "dur": 5.04,
   "pre": 0.3,
   "post": 0.6,
   "anchor": {
    "line": "ex_20",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_22",
   "t": 171.75,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 6.48,
   "ref": "Exodus 12:31-32",
   "zh": "走吧……都走吧！带上你们的羊，统统走吧！",
   "en": "Go... just go! Take your sheep and go, all of you!",
   "dir": "no comedy here: tired, sorrowful, defeated; a long breath first; quiet",
   "dur": 6.43,
   "pre": 1.2,
   "post": 0.8,
   "anchor": {
    "line": "ex_21",
    "edge": "end",
    "dt": 1.8
   }
  },
  {
   "id": "ex_23",
   "t": 181.38,
   "who": "people",
   "voice": "people",
   "maxSec": 1.73,
   "ref": "Exodus 12:41",
   "zh": "我们自由啦！",
   "en": "We're free!",
   "dir": "a crowd cheering together, joyful and ragged; some laughing",
   "dur": 1.68,
   "pre": 2.4,
   "post": 0.4,
   "anchor": {
    "line": "ex_22",
    "edge": "end",
    "dt": 3.2
   }
  },
  {
   "id": "ex_24",
   "t": 183.76,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.32,
   "ref": "Exodus 13:21",
   "zh": "上帝白天用云柱、晚上用火柱，在前面给他们带路。",
   "en": "God went ahead of them: a pillar of cloud by day, and a pillar of fire by night.",
   "dir": "wonder, warm and bright",
   "dur": 6.27,
   "pre": 0.3,
   "post": 0.6,
   "anchor": {
    "line": "ex_23",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "ex_25",
   "t": 191.03,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 7.31,
   "ref": "Exodus 14:5-7",
   "zh": "等等！他们都走了……谁给我做砖呀？备车！快追！",
   "en": "Wait! They've all gone... then who's going to make my bricks? My chariot! After them!",
   "dir": "comic tantrum: realisation, then outraged, then bossy shouting; a stamp in the rhythm",
   "dur": 7.26,
   "pre": 0.4,
   "post": 0.2,
   "anchor": {
    "line": "ex_24",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "ex_26",
   "t": 198.89,
   "who": "miriam",
   "voice": "miriam",
   "maxSec": 5.67,
   "ref": "Exodus 14:10-11",
   "zh": "摩西！前面是大海，后面是法老的兵车……我们怎么办呀？",
   "en": "Moses! The sea is in front of us, and Pharaoh's chariots are behind us... what do we do?",
   "dir": "frightened, fast, breathless; pitch rising to the question",
   "dur": 5.62,
   "pre": 0.4,
   "post": 0.3,
   "anchor": {
    "line": "ex_25",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_27",
   "t": 205.11,
   "who": "moses",
   "voice": "moses",
   "maxSec": 5.13,
   "ref": "Exodus 14:13",
   "zh": "不要怕！站稳了，看上帝怎样救我们！",
   "en": "Don't be afraid! Stand still, and watch how God will save us!",
   "dir": "calm and strong, the steadiest voice in the story; a hand on her shoulder in the voice",
   "dur": 5.08,
   "pre": 0.3,
   "post": 0.6,
   "anchor": {
    "line": "ex_26",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "ex_28",
   "t": 211.99,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 11.47,
   "ref": "Exodus 14:21-22",
   "zh": "摩西向大海伸出手杖。上帝刮起大风，刮了一整夜——海水哗地分开了，中间出现了一条干干的路！",
   "en": "Moses stretched out his staff over the sea. God sent a strong wind that blew all night, and whoosh! The water split apart, and there was a dry path right through the middle!",
   "dir": "building wonder; quick and big on 哗 / 'whoosh'; awe on 干干的路 / 'dry path'",
   "dur": 11.42,
   "pre": 1.2,
   "post": 0.4,
   "anchor": {
