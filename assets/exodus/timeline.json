  {
   "id": "ex_35",
   "t": 277.39,
   "who": "moses",
   "voice": "moses",
   "maxSec": 4.54,
   "ref": "Exodus 3:7, 15:13",
   "zh": "上帝听见了我们的哭声，一路带着我们走。",
   "en": "God heard us when we cried, and he led us all the way.",
   "dir": "warm, grateful, a grandfather's smile; slow",
   "dur": 4.49,
   "pre": 0.6,
   "post": 0.5,
   "anchor": {
    "line": "ex_34",
