  {
   "id": "ex_29",
   "t": 224.21,
   "who": "miriam",
   "voice": "miriam",
   "maxSec": 5.86,
   "ref": "Exodus 14:22",
   "zh": "哇……海水像两面墙一样！大家快走！",
   "en": "Wow... the water is standing up like two walls! Come on, everyone, let's go!",
   "dir": "breathless wonder first, then a happy call to the crowd",
   "dur": 5.81,
   "pre": 0.4,
   "post": 0.2,
   "anchor": {
    "line": "ex_28",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "ex_30",
   "t": 241.82,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 6.72,
   "ref": "Exodus 14:23-25",
   "zh": "冲啊——咦？我的轮子！哎哎哎……哇啊啊！",
   "en": "Charge! Huh? My wheel! Hey, hey, hey... waaah!",
   "dir": "comic: a proud battle-cry, then puzzled, then wobbling panic, then a long wail",
   "dur": 6.67,
   "pre": 2.6,
   "post": 0.0,
   "anchor": {
    "line": "ex_29",
    "edge": "end",
    "dt": 11.8
   }
  },
  {
   "id": "ex_31",
   "t": 250.09,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 9.13,
   "ref": "Exodus 14:26-29",
   "zh": "海水合拢了，法老的兵车再也追不上了。以色列人平平安安地，走到了大海的那一边！",
   "en": "The water came rushing back, and Pharaoh's chariots could not follow any more. God's people were safe on the other side of the sea!",
   "dir": "relief and joy; slow and warm on 平平安安地 / 'safe'",
   "dur": 9.08,
   "pre": 1.6,
   "post": 0.4,
   "anchor": {
    "line": "ex_30",
    "edge": "end",
    "dt": 1.6
   }
  },
  {
   "id": "ex_32",
   "t": 260.17,
   "who": "pharaoh",
   "voice": "pharaoh",
   "maxSec": 3.35,
   "ref": "Exodus 14:30",
   "zh": "阿……阿……阿嚏！",
   "en": "Ah... ah... ACHOO!",
   "dir": "a soggy, sulky sneeze, comic build-up; small and silly, not loud",
   "dur": 3.3,
   "pre": 0.6,
   "post": 0.6,
   "anchor": {
    "line": "ex_31",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "ex_33",
   "t": 265.11,
   "who": "miriam",
   "voice": "miriam",
   "maxSec": 7.84,
   "ref": "Exodus 15:20-21",
   "zh": "唱歌吧，向上帝唱歌！他大大得胜，把马和兵车都抛在海里！",
   "en": "Sing to the Lord, sing! He has won the victory! Horse and chariot, he threw into the sea!",
   "dir": "a joyful chant in rhythm with the tambourine, half-sung, laughing; bounce on every phrase",
   "dur": 7.79,
   "pre": 1.041,
   "post": 0.3,
   "anchor": {
    "line": "ex_32",
    "edge": "end",
    "dt": 1.641
