 "lines": [
  {
   "id": "dg_01",
   "t": 0.5,
   "who": "narrator",
   "maxSec": 5.2,
   "ref": "1 Samuel 17:1-3",
   "zh": "很久以前，以色列人和非利士人，隔着山谷打仗。",
   "en": "Long ago, two armies faced each other across a valley."
  },
  {
   "id": "dg_02",
   "t": 8.4,
   "who": "goliath",
   "maxSec": 4.34,
   "ref": "1 Samuel 17:8-10",
   "zh": "我是歌利亚！派个人出来，跟我打！",
   "en": "I am Goliath! Send someone out to fight me!"
  },
  {
   "id": "dg_03",
   "t": 12.94,
   "who": "narrator",
   "maxSec": 5.24,
   "ref": "1 Samuel 17:4-7",
   "zh": "他差不多有三米高，穿着铜盔甲，拿着大枪。",
   "en": "He was almost three metres tall, in bronze armour!"
  },
  {
   "id": "dg_04",
   "t": 20.78,
   "who": "soldiers",
   "maxSec": 2.92,
   "ref": "1 Samuel 17:11, 24",
   "zh": "他太大了！谁也不敢去！",
   "en": "He's too big! No one dares!"
  },
  {
   "id": "dg_05",
   "t": 23.9,
   "who": "goliath",
   "maxSec": 3.65,
   "ref": "1 Samuel 17:10, 16",
   "zh": "哈哈！你们全是胆小鬼！",
   "en": "Ha ha! You're all too scared!"
  },
  {
   "id": "dg_06",
   "t": 28.75,
   "who": "narrator",
   "maxSec": 5.05,
   "ref": "1 Samuel 17:20-23",
   "zh": "这时，放羊的少年大卫来了。他一点也不怕。",
   "en": "Then David came, a young shepherd boy. He was not afraid."
  },
  {
   "id": "dg_07",
   "t": 34.0,
   "who": "david",
   "maxSec": 2.8,
   "ref": "1 Samuel 17:32",
   "zh": "大家别怕！我去跟他打！",
   "en": "Don't be afraid! I'll fight him!"
  },
  {
   "id": "dg_08",
   "t": 37.2,
   "who": "saul",
   "maxSec": 3.4,
   "ref": "1 Samuel 17:33",
   "zh": "你还是个孩子，怎么打得过他？",
   "en": "You're just a boy. How can you win?"
  },
  {
   "id": "dg_09",
   "t": 40.8,
   "who": "david",
   "maxSec": 4.3,
   "ref": "1 Samuel 17:34-36",
   "zh": "我放羊时，打败过狮子，也打败过熊！",
   "en": "I kept sheep. I beat a lion and a bear!"
  },
  {
   "id": "dg_10",
   "t": 45.3,
   "who": "david",
   "maxSec": 3.9,
   "ref": "1 Samuel 17:37",
   "zh": "上帝救过我，这次也会救我！",
   "en": "The LORD saved me then. He'll save me now!"
  },
  {
   "id": "dg_11",
   "t": 49.6,
   "who": "david",
   "maxSec": 3.3,
   "ref": "1 Samuel 17:38-39",
   "zh": "这盔甲太重了，我不穿了。",
   "en": "Too heavy! I'll go without this armour."
  },
  {
   "id": "dg_12",
   "t": 53.8,
   "who": "narrator",
   "maxSec": 4.0,
   "ref": "1 Samuel 17:40",
   "zh": "大卫在小溪边，挑了五块光滑的石头。",
   "en": "By the brook, David picked five smooth stones."
  },
  {
   "id": "dg_13",
   "t": 61.0,
   "who": "goliath",
   "maxSec": 3.2,
   "ref": "1 Samuel 17:42-44",
   "zh": "小不点，你也想跟我打？",
   "en": "Little boy, you want to fight me?"
  },
  {
   "id": "dg_14",
   "t": 64.4,
   "who": "david",
   "maxSec": 6.0,
   "ref": "1 Samuel 17:45",
   "zh": "你靠的是刀和枪，我靠的是耶和华的名！",
   "en": "You come with sword and spear. I come in the name of the LORD!"
  },
  {
   "id": "dg_15",
   "t": 70.8,
   "who": "narrator",
   "maxSec": 3.3,
   "ref": "1 Samuel 17:48-49",
   "zh": "大卫跑上前去，甩起了机弦！",
   "en": "David ran forward and swung his sling!"
  },
  {
   "id": "dg_16",
   "t": 79.1,
   "who": "narrator",
   "maxSec": 4.57,
   "ref": "1 Samuel 17:49-50",
   "zh": "石头打中额头，巨人咚地倒下了！",
   "en": "The stone hit his forehead. Down fell the giant!"
  },
  {
   "id": "dg_17",
   "t": 84.56,
   "who": "david",
   "maxSec": 3.0,
   "ref": "1 Samuel 17:47",
   "zh": "这场仗，是属于上帝的！",
   "en": "The battle belongs to the LORD!"
  },
  {
   "id": "dg_18",
   "t": 87.76,
   "who": "narrator",
   "maxSec": 4.0,
   "ref": "1 Samuel 17:45-47 (moral)",
   "zh": "个子小不要紧，勇气和信靠上帝更重要！",
   "en": "Courage and trust in God matter more than size!"
  }
 ],
