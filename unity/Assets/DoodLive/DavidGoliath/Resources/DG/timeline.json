 "shots": [
  {
   "id": "S01",
   "t0": 0.0,
   "t1": 8.0,
   "title_zh": "以拉谷",
   "title_en": "The Valley of Elah",
   "camera": {
    "type": "orbit",
    "target": "both",
    "dist": 1.6,
    "height": 0.45,
    "yawDeg": -25
   },
   "desc": "Wide slow orbit over the page. Goliath stomps to his place at the back of the page; dust puffs at each step. David stands small at the front-left, watching."
  },
  {
   "id": "S02",
   "t0": 8.0,
   "t1": 19.78,
   "title_zh": "巨人的挑战",
   "title_en": "The giant's challenge",
   "camera": {
    "type": "fixed",
    "target": "goliath",
    "dist": 1.1,
    "height": 0.12,
    "yawDeg": 15
   },
   "desc": "Low hero angle looking up at Goliath. He taunts with his spear, shouts his challenge, then the narrator tells how big he is; he ends with a roar."
  },
  {
   "id": "S03",
   "t0": 19.78,
   "t1": 28.55,
   "title_zh": "军队害怕了",
   "title_en": "The armies are afraid",
   "camera": {
    "type": "orbit",
    "target": "goliath",
    "dist": 1.4,
    "height": 0.35,
    "yawDeg": -40
   },
   "desc": "Off-screen soldiers gasp and murmur. Goliath laughs at them and mocks them."
  },
  {
   "id": "S04",
   "t0": 28.55,
   "t1": 40.2,
   "title_zh": "牧羊少年大卫",
   "title_en": "David the shepherd",
   "camera": {
    "type": "follow",
    "target": "david",
    "dist": 0.8,
    "height": 0.25,
    "yawDeg": 30
   },
   "desc": "Music turns gentle. David walks forward to centre-left; a sheep bleats off-screen. He says he will go; King Saul (off-screen) says he is only a boy."
  },
  {
   "id": "S05",
   "t0": 40.2,
   "t1": 53.6,
   "title_zh": "狮子、熊和盔甲",
   "title_en": "Lion, bear and armour",
   "camera": {
    "type": "fixed",
    "target": "david",
    "dist": 0.7,
    "height": 0.22,
    "yawDeg": 0
   },
   "desc": "Close on David. A memory bubble shows a lion and a bear above his head while he tells Saul. Then an off-screen clank: he takes off Saul's heavy armour."
  },
  {
   "id": "S06",
   "t0": 53.6,
   "t1": 60.2,
   "title_zh": "五块光滑的石头",
   "title_en": "Five smooth stones",
   "camera": {
    "type": "follow",
    "target": "david",
    "dist": 0.6,
    "height": 0.12,
    "yawDeg": 50
   },
   "desc": "David walks to the brook at the front-left of the page, kneels and picks stones (ripples, five clacks), then walks back to face Goliath."
  },
  {
   "id": "S07",
   "t0": 60.2,
   "t1": 70.0,
   "title_zh": "我靠耶和华的名",
   "title_en": "In the name of the LORD",
   "camera": {
    "type": "fixed",
    "target": "both",
    "dist": 1.3,
    "height": 0.3,
    "yawDeg": 90
   },
   "desc": "Side-on two-shot. Goliath laughs and sneers at the little boy. David answers with the key line; a warm glow rises around him and the music turns brave."
  },
  {
   "id": "S08",
   "t0": 70.0,
   "t1": 75.1,
   "title_zh": "奔跑与甩石",
   "title_en": "The run and the sling",
   "camera": {
    "type": "follow",
    "target": "david",
    "dist": 1.0,
    "height": 0.2,
    "yawDeg": -60
   },
   "desc": "Goliath roars and lumbers forward; David runs to meet him and spins the sling over his head."
  },
  {
   "id": "S09",
   "t0": 75.1,
   "t1": 79.1,
   "title_zh": "一块石头",
   "title_en": "One stone",
   "camera": {
    "type": "fixed",
    "target": "both",
    "dist": 1.6,
    "height": 0.6,
    "yawDeg": 44
   },
   "desc": "Release. Side-on two-shot, square to the line between them: the stone flies from the pouch to Goliath's forehead: flash, dizzy stars, then the giant topples forward onto the page toward the viewer. Dust bursts, the page shakes."
  },
  {
   "id": "S10",
   "t0": 79.1,
   "t1": 82.5,
   "title_zh": "巨人倒下了",
   "title_en": "The giant falls",
   "camera": {
    "type": "orbit",
    "target": "both",
    "dist": 1.3,
    "height": 0.6,
    "yawDeg": -30
   },
   "desc": "High slow orbit. Goliath lies still on the page (down loop). The off-screen army cheers."
  },
  {
   "id": "S11",
   "t0": 82.5,
   "t1": 92.16,
   "title_zh": "勇气和信靠",
   "title_en": "Courage and trust",
   "camera": {
    "type": "fixed",
    "target": "david",
    "dist": 0.8,
    "height": 0.4,
    "yawDeg": -40
   },
   "desc": "David faces the viewer: victory jump, confetti, then he bows his head and prays while golden rays fall and the narrator gives the moral."
  }
 ],
