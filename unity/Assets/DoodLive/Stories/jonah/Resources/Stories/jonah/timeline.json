 ],
 "lines": [
  {
   "id": "jn_01",
   "t": 0.55,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 5.68,
   "ref": "Jonah 1:1",
   "zh": "很久以前，上帝对一个叫约拿的人说话了。",
   "en": "Long ago, God spoke to a man called Jonah.",
   "dir": "storyteller opening, warm and curious, in one breath; a little lift on 上帝 / 'God spoke'",
   "dur": 5.63,
   "pre": 0.25,
   "post": 0.2,
   "anchor": {
    "line": "",
    "edge": "origin",
    "dt": 0.55
   }
  },
  {
   "id": "jn_02",
   "t": 6.78,
   "who": "god",
   "voice": "god",
   "maxSec": 7.25,
   "ref": "Jonah 1:2",
   "zh": "约拿，起来！去尼尼微大城，告诉那里的人：不可以再做坏事了。",
   "en": "Jonah, get up! Go to the great city of Nineveh, and tell the people there to stop doing wrong.",
   "dir": "God's voice: warm, calm, big but kind, like a loving father; never stern or echoing-scary",
   "dur": 7.2,
   "pre": 0.4,
   "post": 0.3,
   "anchor": {
    "line": "jn_01",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_03",
   "t": 14.58,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 4.72,
   "ref": "Jonah 1:3; 4:2",
   "zh": "尼尼微？那些坏人？我才不去呢！",
   "en": "Nineveh? Those bad people? No way. I'm not going!",
   "dir": "grumpy and stubborn, arms crossed; a snort before 我才不去呢 / 'No way'; funny, not angry",
   "dur": 4.67,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_02",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_04",
   "t": 19.75,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.97,
   "ref": "Jonah 1:3",
   "zh": "约拿没有去尼尼微。他偷偷跑到海边，上了一条往相反方向开的船！",
   "en": "But Jonah didn't go to Nineveh. He sneaked down to the sea and got on a ship going the opposite way!",
   "dir": "amused, a little conspiratorial; surprise on 相反方向 / 'the opposite way'",
   "dur": 6.92,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_03",
    "edge": "end",
    "dt": 0.5
   }
  },
  {
   "id": "jn_05",
   "t": 27.27,
   "who": "captain",
   "voice": "captain",
   "maxSec": 3.71,
   "ref": "Jonah 1:3",
   "zh": "欢迎上船！坐稳喽——开船啦！",
   "en": "Welcome aboard! Hold on tight... we're off!",
   "dir": "a jolly, loud sea captain; big chest voice, a laugh in it; calls 开船啦 / 'we're off' like a shout across the deck",
   "dur": 3.66,
   "pre": 0.4,
   "post": 0.2,
   "anchor": {
    "line": "jn_04",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_06",
   "t": 31.63,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.1,
   "ref": "Jonah 1:5",
   "zh": "约拿躲到货物后面，呼噜呼噜睡着了。",
   "en": "Jonah hid behind the cargo, and soon he was snoring away.",
   "dir": "soft and sleepy, smiling; draw out 呼噜呼噜 / 'snoring'",
   "dur": 6.05,
   "pre": 0.5,
   "post": 0.4,
   "anchor": {
    "line": "jn_05",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "jn_07",
   "t": 38.68,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.8,
   "ref": "Jonah 1:4",
   "zh": "忽然，上帝刮起了大风。轰隆隆！船摇啊摇，快要散架了！",
   "en": "Suddenly God sent a great wind. Crash! Boom! The ship rocked and nearly broke apart!",
   "dir": "exciting, quick, wide-eyed; big on 轰隆隆 / 'Crash! Boom!'; thrilling, never frightening",
   "dur": 7.75,
   "pre": 0.6,
   "post": 0.2,
   "anchor": {
    "line": "jn_06",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "jn_08",
   "t": 47.13,
   "who": "captain",
   "voice": "captain",
   "maxSec": 8.46,
   "ref": "Jonah 1:6",
   "zh": "喂！醒醒！这么大的风浪，你怎么还睡得着？快向你的上帝祷告啊！",
   "en": "Hey! Wake up! How can you sleep in a storm like this? Get up and pray to your God!",
   "dir": "shouting over the wind, urgent, amazed; not angry at him, just desperate",
   "dur": 8.41,
   "pre": 0.5,
   "post": 0.3,
   "anchor": {
    "line": "jn_07",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "jn_09",
   "t": 57.24,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 9.46,
   "ref": "Jonah 1:9-12",
   "zh": "这风暴……是因为我。我在躲着上帝。把我扔进海里，风浪就会停了。",
   "en": "This storm... it's because of me. I'm running away from God. Throw me into the sea, and the storm will stop.",
   "dir": "quiet, ashamed, honest; a swallow before 是因为我 / 'because of me'; brave on the last sentence",
   "dur": 9.41,
   "pre": 1.4,
   "post": 0.4,
   "anchor": {
    "line": "jn_08",
    "edge": "end",
    "dt": 1.7
   }
  },
  {
   "id": "jn_10",
   "t": 67.35,
   "who": "captain",
   "voice": "captain",
   "maxSec": 6.33,
   "ref": "Jonah 1:13-14",
   "zh": "扔下去？不行不行！……唉，上帝啊，请原谅我们！",
   "en": "Throw you in? No, no, I can't! ...Oh, God, please forgive us!",
   "dir": "shocked, kind-hearted, torn; a groan on 唉; the prayer is a real plea",
   "dur": 6.28,
   "pre": 0.3,
   "post": 0.0,
   "anchor": {
    "line": "jn_09",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "jn_11",
   "t": 74.23,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.4,
   "ref": "Jonah 1:15",
   "zh": "扑通！约拿一掉进海里，风就停了，浪也静了。",
   "en": "Splash! The moment Jonah hit the water, the wind stopped and the waves went calm.",
   "dir": "a pop on 扑通 / 'Splash', then hushed and amazed as everything goes still",
   "dur": 7.35,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "jn_10",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_12",
   "t": 82.18,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.19,
   "ref": "Jonah 1:17",
   "zh": "约拿往下沉啊沉……上帝派来了一条好大好大的鱼！",
   "en": "Down, down sank Jonah... then God sent a great big fish!",
   "dir": "slow and floaty on the sinking; then wonder and a smile on 好大好大的鱼 / 'great big fish'",
   "dur": 8.14,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_11",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_13",
   "t": 91.52,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 4.83,
   "ref": "Jonah 1:17",
   "zh": "啊呜——一口就把他吞进了肚子里！",
   "en": "GULP! It swallowed him in one bite!",
   "dir": "big, comic, delighted; a real 啊呜 / 'gulp' sound",
   "dur": 4.78,
   "pre": 1.0,
   "post": 0.1,
   "anchor": {
    "line": "jn_12",
    "edge": "end",
    "dt": 1.2
   }
  },
  {
   "id": "jn_14",
   "t": 97.7,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 5.21,
   "ref": "Jonah 1:17",
   "zh": "呃……这里又黑又臭，还滑溜溜的！",
   "en": "Ugh... it's dark in here, and stinky, and so slimy!",
   "dir": "comic disgust, holding his nose (nasal voice); a shudder on 滑溜溜 / 'slimy'",
   "dur": 5.16,
   "pre": 0.5,
   "post": 0.3,
   "anchor": {
    "line": "jn_13",
    "edge": "end",
    "dt": 1.4
   }
  },
  {
   "id": "jn_15",
   "t": 103.46,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.83,
   "ref": "Jonah 1:17; 2:1",
   "zh": "约拿在鱼肚子里待了三天三夜。他终于安静下来，向上帝祷告。",
   "en": "Jonah stayed inside the fish for three days and three nights. At last he grew quiet, and he prayed.",
   "dir": "calm, slowing down; gentle on 向上帝祷告 / 'he prayed'",
   "dur": 7.78,
   "pre": 0.3,
   "post": 0.3,
   "anchor": {
    "line": "jn_14",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_16",
   "t": 112.14,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 10.86,
   "ref": "Jonah 2:2-9",
   "zh": "上帝啊，对不起，我不该逃跑。谢谢你没有丢下我。你说什么，我都愿意去做。",
   "en": "Dear God, I'm sorry. I should not have run away. Thank You for not letting go of me. Whatever You say, I will do.",
   "dir": "a real prayer, soft and close; truly sorry, then thankful, then steady; breath before 谢谢你",
   "dur": 10.81,
   "pre": 0.6,
   "post": 0.4,
   "anchor": {
    "line": "jn_15",
    "edge": "end",
    "dt": 0.9
   }
  },
  {
   "id": "jn_17",
   "t": 123.95,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 4.95,
   "ref": "Jonah 2:10",
   "zh": "上帝吩咐大鱼，大鱼就游到岸边——",
   "en": "Then God spoke to the fish, and the fish swam up to the shore...",
   "dir": "building up to a joke; hold the last word",
   "dur": 4.9,
   "pre": 0.6,
   "post": 0.1,
   "anchor": {
    "line": "jn_16",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "jn_18",
   "t": 129.55,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 5.15,
   "ref": "Jonah 2:10",
   "zh": "呸！把约拿吐在了沙滩上。",
   "en": "PFFT! And spat Jonah out onto the sand.",
   "dir": "the punchline: a real 呸 / 'pfft', then a chuckle",
   "dur": 5.1,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "jn_17",
    "edge": "end",
    "dt": 0.7
   }
  },
  {
   "id": "jn_19",
   "t": 136.15,
   "who": "god",
   "voice": "god",
   "maxSec": 5.03,
   "ref": "Jonah 3:1-2",
   "zh": "约拿，起来，去尼尼微，把我的话告诉他们。",
   "en": "Jonah, get up. Go to Nineveh, and give them My message.",
   "dir": "the same warm voice as before, patient, a hint of a smile: a second chance",
   "dur": 4.98,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "jn_18",
    "edge": "end",
    "dt": 1.5
   }
  },
  {
   "id": "jn_20",
   "t": 141.73,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 3.35,
   "ref": "Jonah 3:3",
   "zh": "好，上帝。这一次，我去。",
   "en": "Yes, God. This time, I'll go.",
   "dir": "humble and sure; short; a deep breath first",
   "dur": 3.3,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_19",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_21",
   "t": 147.03,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 8.0,
   "ref": "Jonah 3:4",
   "zh": "尼尼微的人哪，听着！你们做了太多坏事。再过四十天，这座城就要完了！",
   "en": "People of Nineveh, listen! You have done so many wrong things. In forty days, this city will be destroyed!",
   "dir": "calling out to a whole city, hands cupped; loud and serious but not cruel",
   "dur": 7.95,
   "pre": 1.8,
   "post": 0.3,
   "anchor": {
    "line": "jn_20",
    "edge": "end",
    "dt": 2.0
   }
  },
  {
   "id": "jn_22",
   "t": 155.78,
   "who": "people",
   "voice": "people",
   "maxSec": 8.32,
   "ref": "Jonah 3:5-9",
   "zh": "我们错了！上帝啊，求你原谅我们！",
   "en": "We were wrong! O God, please forgive us!",
   "dir": "a big crowd behind a wall: men, women and children, ragged, heartfelt, not in unison",
   "dur": 8.27,
   "pre": 0.5,
   "post": 0.3,
   "anchor": {
    "line": "jn_21",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "jn_23",
   "t": 164.65,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 9.89,
   "ref": "Jonah 3:5-10",
   "zh": "从国王到小孩子，全城的人都不再做坏事了。上帝看见了，就原谅了他们。",
   "en": "From the king to the smallest child, everyone in the city stopped doing wrong. God saw it, and He forgave them.",
   "dir": "glad and gentle; warm and slow on 就原谅了他们 / 'He forgave them'",
   "dur": 9.84,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_22",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_24",
   "t": 175.99,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 6.28,
   "ref": "Jonah 4:1-2",
   "zh": "哼！我就知道！你太好心了，肯定会原谅他们。他们可是坏人哪！",
   "en": "Hmph! I knew it! You are too kind. I knew You would forgive them. But they're the bad guys!",
   "dir": "sulky like a child who lost a game; loud 哼; whiny on the last sentence; funny",
   "dur": 6.23,
   "pre": 1.3,
   "post": 0.3,
   "anchor": {
    "line": "jn_23",
    "edge": "end",
    "dt": 1.5
   }
  },
  {
   "id": "jn_25",
   "t": 183.12,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 10.47,
   "ref": "Jonah 4:6",
   "zh": "上帝让一棵树长出来，给约拿遮太阳。约拿可高兴了：啊，真凉快！",
   "en": "God made a leafy plant grow up to shade Jonah from the sun. Jonah was so happy. Ahh, lovely and cool!",
   "dir": "light and playful; a contented sigh on 啊真凉快 / 'lovely and cool'",
   "dur": 10.42,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "jn_24",
    "edge": "end",
    "dt": 0.9
   }
  },
  {
   "id": "jn_26",
   "t": 194.14,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 10.97,
   "ref": "Jonah 4:7-8",
   "zh": "可是第二天，来了一条小虫子。咔嚓咔嚓——把树咬坏了。太阳晒得约拿头都晕了。",
   "en": "But the next day, along came a little worm. Munch, munch... and the plant dried up. The hot sun beat down on Jonah's head.",
   "dir": "mischievous on the worm (咔嚓咔嚓 / 'munch munch'), then hot and droopy",
   "dur": 10.92,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "jn_25",
    "edge": "end",
    "dt": 0.6
   }
  },
  {
   "id": "jn_27",
   "t": 205.46,
   "who": "jonah",
   "voice": "jonah",
   "maxSec": 3.42,
   "ref": "Jonah 4:8-9",
   "zh": "我的树！我可怜的树啊！",
   "en": "My plant! My poor, poor plant!",
   "dir": "over-the-top wailing, comic; voice cracks",
   "dur": 3.37,
   "pre": 0.2,
   "post": 0.4,
   "anchor": {
    "line": "jn_26",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "jn_28",
   "t": 209.83,
   "who": "god",
   "voice": "god",
   "maxSec": 10.58,
   "ref": "Jonah 4:10-11",
   "zh": "约拿，你心疼这棵树。尼尼微有十二万多人，还有好多牛羊，我能不心疼吗？",
   "en": "Jonah, you care about this plant. Nineveh has over a hundred and twenty thousand people, and many animals too. Should I not care about them?",
   "dir": "very gentle, a father explaining; a small smile on 还有好多牛羊 / 'animals too'; the question is tender, not scolding",
   "dur": 10.53,
   "pre": 0.6,
   "post": 0.5,
   "anchor": {
    "line": "jn_27",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "jn_29",
   "t": 221.36,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 9.66,
   "ref": "Jonah 4:2, 4:11",
   "zh": "上帝爱每一个人，做错了事，他也愿意再给一次机会。约拿是这样，你和我也是。",
   "en": "God loves every person. When we do wrong, He gives another chance. He did for Jonah, and He does for you and me.",
   "dir": "warm moral, speaking right to the child; smile on the last sentence",
   "dur": 9.61,
   "pre": 0.5,
   "post": 0.4,
   "anchor": {
    "line": "jn_28",
    "edge": "end",
    "dt": 1.0
   }
  }
 ],
