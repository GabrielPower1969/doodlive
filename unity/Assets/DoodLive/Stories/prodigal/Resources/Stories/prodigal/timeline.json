 "lines": [
  {
   "id": "pr_01",
   "t": 1.45,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 10.55,
   "ref": "Luke 15:11",
   "zh": "耶稣讲过一个故事。有个爸爸，他有两个儿子。哥哥天天在田里干活，弟弟呢……就爱玩。",
   "en": "Jesus once told a story. There was a father who had two sons. The big brother worked in the field every day. The little brother... just liked to play.",
   "dir": "storyteller opening, warm; a little smile and a pause before 就爱玩 / 'just liked to play'",
   "dur": 10.5,
   "pre": 0.25,
   "post": 0.4,
   "anchor": {
    "line": "",
    "edge": "origin",
    "dt": 1.45
   }
  },
  {
   "id": "pr_02",
   "t": 13.95,
   "who": "son",
   "voice": "son",
   "maxSec": 5.58,
   "ref": "Luke 15:12",
   "zh": "爸爸！把我该得的那份家产给我吧。我要去远方，好好玩一玩！",
   "en": "Dad! Give me my share of everything now. I want to go far away and have some fun!",
   "dir": "cheeky, breezy, a bit spoilt; bright on 好好玩一玩 / 'have some fun'",
   "dur": 5.53,
   "pre": 1.6,
   "post": 0.5,
   "anchor": {
    "line": "pr_01",
    "edge": "end",
    "dt": 2.0
   }
  },
  {
   "id": "pr_03",
   "t": 20.38,
   "who": "father",
   "voice": "father",
   "maxSec": 9.01,
   "ref": "Luke 15:12",
   "zh": "唉……好吧，孩子。这是你的。你……要小心啊。",
   "en": "Oh... all right, my son. Here it is. Please... be careful.",
   "dir": "a sad sigh first; loving, slow; a catch in the voice before 要小心啊 / 'be careful'",
   "dur": 8.96,
   "pre": 0.4,
   "post": 0.6,
   "anchor": {
    "line": "pr_02",
    "edge": "end",
    "dt": 0.9
   }
  },
  {
   "id": "pr_04",
   "t": 30.24,
   "who": "son",
   "voice": "son",
   "maxSec": 2.62,
   "ref": "Luke 15:13",
   "zh": "拜拜！我要去过好日子啦！",
   "en": "Bye-bye! I'm off to live the good life!",
   "dir": "carefree, sing-song, already walking away",
   "dur": 2.57,
   "pre": 0.3,
   "post": 0.2,
   "anchor": {
    "line": "pr_03",
    "edge": "end",
    "dt": 0.9
   }
  },
  {
   "id": "pr_05",
   "t": 34.61,
   "who": "brother",
   "voice": "brother",
   "maxSec": 2.73,
   "ref": "Luke 15:12-13",
   "zh": "哼，就知道玩。",
   "en": "Hmph. All he thinks about is having fun.",
   "dir": "grumbling under his breath, leaning on his hoe",
   "dur": 2.68,
   "pre": 1.6,
   "post": 0.3,
   "anchor": {
    "line": "pr_04",
    "edge": "end",
    "dt": 1.8
   }
  },
  {
   "id": "pr_06",
   "t": 41.19,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 7.31,
   "ref": "Luke 15:13",
   "zh": "到了远方，他天天请客、买糖、买新衣服，花钱像流水一样。",
   "en": "In the far country he threw parties every day, bought sweets and fancy clothes, and spent money like water.",
   "dir": "lively and a bit disapproving, like telling about a naughty friend",
   "dur": 7.26,
   "pre": 1.0,
   "post": 0.2,
   "anchor": {
    "line": "pr_05",
    "edge": "end",
    "dt": 3.9
   }
  },
  {
   "id": "pr_07",
   "t": 48.85,
   "who": "son",
   "voice": "son",
   "maxSec": 3.41,
   "ref": "Luke 15:13",
   "zh": "大家随便吃！今天我请客！",
   "en": "Eat whatever you like, everyone! It's on me!",
   "dir": "show-off, loud, laughing",
   "dur": 3.36,
   "pre": 0.2,
   "post": 0.1,
   "anchor": {
    "line": "pr_06",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "pr_08",
   "t": 52.41,
   "who": "friends",
   "voice": "friends",
   "maxSec": 2.47,
   "ref": "Luke 15:13",
   "zh": "好耶！你最好啦！",
   "en": "Yay! You're the best!",
   "dir": "three or four friends cheering together, giggly, a bit greedy",
   "dur": 2.42,
   "pre": 0.1,
   "post": 0.3,
   "anchor": {
    "line": "pr_07",
    "edge": "end",
    "dt": 0.2
   }
  },
  {
   "id": "pr_09",
   "t": 57.53,
   "who": "son",
   "voice": "son",
   "maxSec": 3.33,
   "ref": "Luke 15:14",
   "zh": "咦？钱呢？……一个都没有了？",
   "en": "Huh? Where's my money?... There's none left?",
   "dir": "puzzled, then dawning horror; small voice on 一个都没有了 / 'none left'",
   "dur": 3.28,
   "pre": 1.2,
   "post": 0.2,
   "anchor": {
    "line": "pr_08",
    "edge": "end",
    "dt": 2.7
   }
  },
  {
   "id": "pr_10",
   "t": 61.21,
   "who": "friends",
   "voice": "friends",
   "maxSec": 5.63,
   "ref": "Luke 15:13-14",
   "zh": "没钱了？那……我们走啦，拜拜！",
   "en": "No money? Oh... well, we're off then. Bye!",
   "dir": "suddenly cool and off-hand, drifting away, voices fading",
   "dur": 5.58,
   "pre": 0.2,
   "post": 0.6,
   "anchor": {
    "line": "pr_09",
    "edge": "end",
    "dt": 0.4
   }
  },
  {
   "id": "pr_11",
   "t": 68.39,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 5.68,
   "ref": "Luke 15:14",
   "zh": "偏偏这时候，那地方闹了大饥荒，什么吃的都没有了。",
   "en": "And just then a great famine came to that land. There was nothing to eat.",
   "dir": "slower, serious, a dry hush",
   "dur": 5.63,
   "pre": 1.0,
   "post": 0.4,
   "anchor": {
    "line": "pr_10",
    "edge": "end",
    "dt": 1.6
   }
  },
  {
   "id": "pr_12",
   "t": 75.42,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 2.37,
   "ref": "Luke 15:15",
   "zh": "他只好去给人家喂猪。",
   "en": "So he had to take a job feeding pigs.",
   "dir": "matter-of-fact with a tiny wince on 喂猪 / 'pigs'",
   "dur": 2.32,
   "pre": 1.0,
   "post": 0.2,
   "anchor": {
    "line": "pr_11",
    "edge": "end",
    "dt": 1.4
   }
  },
  {
   "id": "pr_13",
   "t": 81.34,
   "who": "son",
   "voice": "son",
   "maxSec": 5.27,
   "ref": "Luke 15:16",
   "zh": "好饿呀……连猪吃的豆荚，看起来都好香……",
   "en": "I'm so hungry... even the pigs' pods look yummy...",
   "dir": "weak, sorry for himself; a stomach-rumble pause; comic longing on 好香 / 'yummy'",
   "dur": 5.22,
   "pre": 3.4,
   "post": 0.3,
   "anchor": {
    "line": "pr_12",
    "edge": "end",
    "dt": 3.6
   }
  },
  {
   "id": "pr_14",
   "t": 88.26,
   "who": "son",
   "voice": "son",
   "maxSec": 7.06,
   "ref": "Luke 15:17",
   "zh": "我爸爸家里的工人，个个都有饭吃……我却在这里饿肚子。",
   "en": "Even the workers at my dad's house have plenty to eat... and here I am, starving.",
   "dir": "quiet, realising, close to tears",
   "dur": 7.01,
   "pre": 1.4,
   "post": 0.6,
   "anchor": {
    "line": "pr_13",
    "edge": "end",
    "dt": 1.7
   }
  },
  {
   "id": "pr_15",
   "t": 96.57,
   "who": "son",
   "voice": "son",
   "maxSec": 1.85,
   "ref": "Luke 15:18",
   "zh": "对了！我要回家！",
   "en": "That's it! I'll go home!",
   "dir": "sudden resolve, hope in the voice",
   "dur": 1.8,
   "pre": 0.7,
   "post": 0.4,
   "anchor": {
    "line": "pr_14",
    "edge": "end",
    "dt": 1.3
   }
  },
  {
   "id": "pr_16",
   "t": 99.37,
   "who": "son",
   "voice": "son",
   "maxSec": 8.77,
   "ref": "Luke 15:18-19",
   "zh": "爸爸，我错了……我得罪了上帝，也得罪了你。我不配做你的儿子了，让我做你的工人吧。",
   "en": "Dad, I was wrong... I sinned against God and against you. I don't deserve to be your son. Let me be one of your workers.",
   "dir": "trying it out, earnest, a little clumsy; a breath between sentences",
   "dur": 8.72,
   "pre": 0.6,
   "post": 0.3,
   "anchor": {
    "line": "pr_15",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "pr_17",
   "t": 108.59,
   "who": "son",
   "voice": "son",
   "maxSec": 2.29,
   "ref": "Luke 15:19",
   "zh": "嗯……就这么说。",
   "en": "Hmm... yes. I'll say that.",
   "dir": "to himself, nodding, nervous",
   "dur": 2.24,
   "pre": 0.2,
   "post": 0.4,
   "anchor": {
    "line": "pr_16",
    "edge": "end",
    "dt": 0.5
   }
  },
  {
   "id": "pr_18",
   "t": 112.03,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 4.64,
   "ref": "Luke 15:20",
   "zh": "爸爸每天都站在路口，往远处看。",
   "en": "Every day, the father stood at the gate and looked down the road.",
   "dir": "tender, slow, a longing in it",
   "dur": 4.59,
   "pre": 0.8,
   "post": 0.4,
   "anchor": {
    "line": "pr_17",
    "edge": "end",
    "dt": 1.2
   }
  },
  {
   "id": "pr_19",
   "t": 117.42,
   "who": "father",
   "voice": "father",
   "maxSec": 3.96,
   "ref": "Luke 15:20",
   "zh": "那是……那是我的孩子！",
   "en": "Is that... is that my boy?!",
   "dir": "disbelief turning into joy; breath catching; rising",
   "dur": 3.91,
   "pre": 0.4,
   "post": 0.1,
   "anchor": {
    "line": "pr_18",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "pr_20",
   "t": 125.63,
   "who": "son",
   "voice": "son",
   "maxSec": 3.95,
   "ref": "Luke 15:21",
   "zh": "爸爸，我错了，我不配做你的儿子……",
   "en": "Dad, I was wrong. I don't deserve to be your son...",
   "dir": "crying softly, small; trails off as he's interrupted",
   "dur": 3.9,
   "pre": 0.6,
   "post": 0.0,
   "anchor": {
    "line": "pr_19",
    "edge": "end",
    "dt": 4.3
   }
  },
  {
   "id": "pr_21",
   "t": 129.63,
   "who": "father",
   "voice": "father",
   "maxSec": 8.89,
   "ref": "Luke 15:22-23",
   "zh": "快！拿最好的袍子给他穿上，把戒指给他戴上！我们要摆宴席，好好庆祝！",
   "en": "Quick! Bring the best robe and put it on him! Put a ring on his finger! We're going to have a feast!",
   "dir": "cutting in happily, laughing through tears, loud and bustling",
   "dur": 8.84,
   "pre": 0.1,
   "post": 0.1,
   "anchor": {
    "line": "pr_20",
    "edge": "end",
    "dt": 0.1
   }
  },
  {
   "id": "pr_22",
   "t": 138.67,
   "who": "servants",
   "voice": "servants",
   "maxSec": 1.62,
   "ref": "Luke 15:22",
   "zh": "是，主人！",
   "en": "Yes, master!",
   "dir": "two or three servants answering eagerly, off-stage",
   "dur": 1.57,
   "pre": 0.1,
   "post": 0.3,
   "anchor": {
    "line": "pr_21",
    "edge": "end",
    "dt": 0.2
   }
  },
  {
   "id": "pr_23",
   "t": 147.74,
   "who": "father",
   "voice": "father",
   "maxSec": 6.04,
   "ref": "Luke 15:24",
   "zh": "我这个儿子，是死而复活，失而又得的！",
   "en": "This son of mine was dead and is alive again! He was lost, and now he is found!",
   "dir": "joyful announcement to everyone, slow and big on 失而又得 / 'lost... found'",
   "dur": 5.99,
   "pre": 4.2,
   "post": 0.3,
   "anchor": {
    "line": "pr_22",
    "edge": "end",
    "dt": 7.5
   }
  },
  {
   "id": "pr_24",
   "t": 160.03,
   "who": "brother",
   "voice": "brother",
   "maxSec": 8.8,
   "ref": "Luke 15:25-27",
   "zh": "咦？家里怎么这么热闹？……什么？弟弟回来了，爸爸还给他摆宴席？",
   "en": "Huh? What's all that noise at home?... What? My brother's back, and Dad's throwing him a party?",
   "dir": "puzzled, then outraged disbelief",
   "dur": 8.75,
   "pre": 4.4,
   "post": 0.2,
   "anchor": {
    "line": "pr_23",
    "edge": "end",
    "dt": 6.3
   }
  },
  {
   "id": "pr_25",
   "t": 169.58,
   "who": "brother",
   "voice": "brother",
   "maxSec": 2.76,
   "ref": "Luke 15:28",
   "zh": "哼！我才不进去！",
   "en": "Hmph! I'm not going in!",
   "dir": "sulky, stubborn, loud",
   "dur": 2.71,
   "pre": 0.6,
   "post": 0.6,
   "anchor": {
    "line": "pr_24",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "pr_26",
   "t": 175.69,
   "who": "brother",
   "voice": "brother",
   "maxSec": 9.54,
   "ref": "Luke 15:29-30",
   "zh": "我天天给你干活，从来没有不听话。可你连一只小山羊都没给过我！",
   "en": "I've worked for you every single day and never disobeyed you. But you never even gave me a little goat!",
   "dir": "hurt and angry, voice cracking a little at the end",
   "dur": 9.49,
   "pre": 2.8,
   "post": 0.4,
   "anchor": {
    "line": "pr_25",
    "edge": "end",
    "dt": 3.4
   }
  },
  {
   "id": "pr_27",
   "t": 185.98,
   "who": "father",
   "voice": "father",
   "maxSec": 12.25,
   "ref": "Luke 15:31-32",
   "zh": "孩子，你一直和我在一起，我的一切都是你的。可你弟弟是失而又得的，我们怎么能不高兴呢？",
   "en": "My son, you are always with me, and everything I have is yours. But your brother was lost and is found. How can we not be glad?",
   "dir": "very gentle, patient, loving both sons; slow; hopeful question",
   "dur": 12.2,
   "pre": 0.4,
   "post": 1.2,
   "anchor": {
    "line": "pr_26",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "pr_28",
   "t": 204.78,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 8.25,
   "ref": "Luke 15:20, 15:24",
   "zh": "耶稣讲这个故事，是要告诉我们：天父就像这个爸爸。不管你走多远，他都在等你回家。",
   "en": "Jesus told this story to show us that God our Father is like this dad. However far you go, he is waiting for you to come home.",
   "dir": "warm moral, speaking right to the child",
   "dur": 8.2,
   "pre": 1.0,
   "post": 0.4,
   "anchor": {
    "line": "pr_27",
    "edge": "end",
    "dt": 6.6
   }
  },
  {
   "id": "pr_29",
   "t": 213.78,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.72,
   "ref": "Luke 15:20-21",
   "zh": "做错了事，说一声「对不起」，回到他身边，他会张开手臂抱你哦！",
   "en": "If you've done something wrong, say sorry and come back to him. He'll run to give you a big hug!",
   "dir": "smiling, gentle encouragement; last words like a hug",
   "dur": 6.67,
   "pre": 0.4,
   "post": 2.2,
   "anchor": {
    "line": "pr_28",
    "edge": "end",
    "dt": 0.8
   }
  }
 ],
