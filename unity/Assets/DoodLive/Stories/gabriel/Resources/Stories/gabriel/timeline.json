 "lines": [
  {
   "id": "ga_01",
   "t": 1.45,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 10.48,
   "ref": "Revelation 21:23; Luke 1:19",
   "zh": "在天上，有一座发光的城。那里住着上帝的天使。其中有一位大天使，名字叫加百列。",
   "en": "High above, there is a city full of light, where God's angels live. One of them is a great archangel. His name is Gabriel.",
   "dir": "hushed wonder, like opening a treasure box; slow, a smile on the name 加百列 / 'Gabriel'",
   "dur": 10.43,
   "pre": 0.25,
   "post": 0.3,
   "anchor": {
    "line": "",
    "edge": "origin",
    "dt": 1.45
   }
  },
  {
   "id": "ga_02",
   "t": 20.58,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 5.65,
   "ref": "Luke 1:13, 1:19",
   "zh": "不要怕，小朋友！我是加百列，是站在上帝面前的天使。",
   "en": "Don't be afraid, little one! I am Gabriel. I stand in the presence of God.",
   "dir": "warm, strong and gentle at once, a big brother kneeling down to a small child; a smile in the voice; the name said with quiet joy",
   "dur": 5.6,
   "pre": 2.0,
   "post": 0.5,
   "anchor": {
    "line": "ga_01",
    "edge": "end",
    "dt": 8.7
   }
  },
  {
   "id": "ga_03",
   "t": 26.98,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 4.45,
   "ref": "Luke 1:19",
   "zh": "上帝常常派我，把他的好消息，送给他爱的人。",
   "en": "God sends me to carry His good news to the people He loves.",
   "dir": "kind, like telling a secret about his job; a little proud and happy",
   "dur": 4.4,
   "pre": 0.3,
   "post": 0.6,
   "anchor": {
    "line": "ga_02",
    "edge": "end",
    "dt": 0.8
   }
  },
  {
   "id": "ga_04",
   "t": 33.38,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 6.83,
   "ref": "Daniel 9:21-23",
   "zh": "很久以前，但以理在祷告，我就飞去告诉他：上帝很爱你！",
   "en": "Long ago, when Daniel was praying, I flew to him to tell him: God loves you very much!",
   "dir": "storytelling, bright; a little lift on 飞去 / 'flew'; tender on 很爱你 / 'loves you'",
   "dur": 6.78,
   "pre": 1.4,
   "post": 0.5,
   "anchor": {
    "line": "ga_03",
    "edge": "end",
    "dt": 2.0
   }
  },
  {
   "id": "ga_05",
   "t": 41.26,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 8.76,
   "ref": "Luke 1:26-31",
   "zh": "后来，我又去见一个叫马利亚的女孩，告诉她：你要生一个儿子，给他起名叫耶稣！",
   "en": "Later, I went to a young woman named Mary, and told her: you will have a baby boy, and you will name him Jesus!",
   "dir": "joyful and full of wonder; slow and glowing on 耶稣 / 'Jesus'",
   "dur": 8.71,
   "pre": 0.6,
   "post": 0.6,
   "anchor": {
    "line": "ga_04",
    "edge": "end",
    "dt": 1.1
   }
  },
  {
   "id": "ga_06",
   "t": 51.37,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 4.24,
   "ref": "Luke 2:10",
   "zh": "这是全世界最好的消息！听——",
   "en": "It's the best news in the whole world! Listen...",
   "dir": "excited, building; a breath and a hush on 听 / 'Listen'",
   "dur": 4.19,
   "pre": 0.8,
   "post": 0.2,
   "anchor": {
    "line": "ga_05",
    "edge": "end",
    "dt": 1.4
   }
  },
  {
   "id": "ga_07",
   "t": 64.76,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 7.02,
   "ref": "Isaiah 41:10; Psalm 121:7-8",
   "zh": "上帝爱你。不管你在哪里，他都看顾你。所以，不要怕！",
   "en": "God loves you. Wherever you are, He is watching over you. So don't be afraid!",
   "dir": "the heart of the story: slow, warm, very sure; a soft pause before 所以 / 'So'",
   "dur": 6.97,
   "pre": 1.2,
   "post": 0.6,
   "anchor": {
    "line": "ga_06",
    "edge": "end",
    "dt": 9.2
   }
  },
  {
   "id": "ga_08",
   "t": 72.73,
   "who": "gabriel",
   "voice": "gabriel",
   "maxSec": 4.97,
   "ref": "",
   "zh": "下次，把我涂上你最喜欢的颜色吧！再见啦！",
   "en": "Next time, colour me in with your favourite colours! Goodbye for now!",
   "dir": "playful and warm, a laugh in it; big friendly goodbye",
   "dur": 4.92,
   "pre": 0.4,
   "post": 0.3,
   "anchor": {
    "line": "ga_07",
    "edge": "end",
    "dt": 1.0
   }
  },
  {
   "id": "ga_09",
   "t": 80.55,
   "who": "narrator",
   "voice": "narrator",
   "maxSec": 6.29,
   "ref": "Luke 2:10",
   "zh": "加百列飞回了天上。上帝的好消息，也是给你的哦！",
   "en": "Gabriel flew back up to heaven. And God's good news is for you, too!",
   "dir": "warm closing, speaking right to the child; smile on the last words",
   "dur": 6.24,
   "pre": 2.6,
   "post": 2.4,
   "anchor": {
    "line": "ga_08",
    "edge": "end",
    "dt": 2.9
   }
  }
 ],
